                                        "properties": {
                                          "style": "text",
                                          "actions": [
                                            {
                                              "id": "cancel_edit_title",
                                              "type": "setVariable",
                                              "variableId": "edit_task_title",
                                              "value": ""
                                            },
                                            {
                                              "id": "cancel_edit_id",
                                              "type": "setVariable",
                                              "variableId": "editing_task_id",
                                              "value": ""
                                            },
                                            {
                                              "id": "cancel_hide_edit_form",
                                              "type": "updateWidget",
                                              "targetPageId": "home",
                                              "targetNodeId": "edit_task_form",
                                              "property": "visible",
                                              "value": false
                                            }
                                          ],
                                          "label": "Cancel"
                                        },
                                        "children": []
                                      }
                                    ]
                                  }
                                ]
