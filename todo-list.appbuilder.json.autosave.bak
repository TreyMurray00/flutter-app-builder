                                    "properties": {
                                      "fontWeight": "bold",
                                      "fontSize": 10.0,
                                      "color": 4286091399,
                                      "text": "EDIT TASK",
                                      "marginBottom": 8.0
                                    },
                                    "children": []
                                  },
                                  {
                                    "id": "edit_task_title_field",
                                    "type": "textField",
                                    "properties": {
                                      "inputVariableId": "edit_task_title",
                                      "width": 184.0,
                                      "hintText": "Update this task",
                                      "initialValue": "",
                                      "label": "Task title"
                                    },
                                    "children": []
                                  },
                                  {
                                    "id": "edit_task_actions",
                                    "type": "wrap",
                                    "properties": {
                                      "direction": "horizontal",
                                      "spacing": 4.0,
                                      "runSpacing": 4.0
                                    },
                                    "children": [
                                      {
                                        "id": "save_task_edit_button",
                                        "type": "button",
                                        "properties": {
                                          "style": "filledTonal",
                                          "actions": [
                                            {
                                              "id": "validate_task_edit",
                                              "type": "conditional",
                                              "variableId": "edit_task_title",
                                              "operator": "notEquals",
                                              "value": "",
                                              "thenActions": [
                                                {
                                                  "id": "update_task_title",
                                                  "type": "databaseUpdate",
                                                  "collectionId": "tasks",
                                                  "recordId": "$editing_task_id",
                                                  "record": "{\"title\":\"$edit_task_title\"}"
                                                },
                                                {
                                                  "id": "clear_edit_title",
                                                  "type": "setVariable",
                                                  "variableId": "edit_task_title",
                                                  "value": ""
                                                },
                                                {
                                                  "id": "clear_edit_id",
                                                  "type": "setVariable",
                                                  "variableId": "editing_task_id",
                                                  "value": ""
                                                },
                                                {
                                                  "id": "hide_edit_form",
                                                  "type": "updateWidget",
                                                  "targetPageId": "home",
                                                  "targetNodeId": "edit_task_form",
                                                  "property": "visible",
                                                  "value": false
                                                }
                                              ],
                                              "elseActions": [
                                                {
                                                  "id": "empty_edit_message",
                                                  "type": "snackbar",
                                                  "message": "Enter a task title."
