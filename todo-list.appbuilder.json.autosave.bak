                                        "properties": {
                                          "direction": "horizontal",
                                          "spacing": 2.0,
                                          "runSpacing": 2.0
                                        },
                                        "children": [
                                          {
                                            "id": "mark_done_button",
                                            "type": "button",
                                            "properties": {
                                              "style": "text",
                                              "actions": [
                                                {
                                                  "id": "mark_task_done",
                                                  "type": "databaseUpdate",
                                                  "collectionId": "tasks",
                                                  "recordId": "${record._id}",
                                                  "record": "{\"status\":\"Done\"}"
                                                }
                                              ],
                                              "label": "Done"
                                            },
                                            "children": []
                                          },
                                          {
                                            "id": "reopen_task_button",
                                            "type": "button",
                                            "properties": {
                                              "style": "text",
                                              "actions": [
                                                {
                                                  "id": "reopen_task",
                                                  "type": "databaseUpdate",
                                                  "collectionId": "tasks",
                                                  "recordId": "${record._id}",
                                                  "record": "{\"status\":\"Open\"}"
                                                }
                                              ],
                                              "label": "Reopen"
                                            },
                                            "children": []
                                          },
                                          {
                                            "id": "edit_task_button",
                                            "type": "button",
                                            "properties": {
                                              "style": "text",
                                              "actions": [
                                                {
                                                  "id": "select_task_id",
                                                  "type": "setVariable",
                                                  "variableId": "editing_task_id",
                                                  "value": "${record._id}"
                                                },
                                                {
                                                  "id": "select_task_title",
                                                  "type": "setVariable",
                                                  "variableId": "edit_task_title",
                                                  "value": "${record.title}"
