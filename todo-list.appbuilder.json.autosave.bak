        "id": "home_scaffold",
        "type": "scaffold",
        "properties": {},
        "children": [
          {
            "id": "home_safe_area",
            "type": "safeArea",
            "properties": {
              "top": true,
              "bottom": true,
              "right": true,
              "left": true
            },
            "children": [
              {
                "id": "desktop_workspace",
                "type": "row",
                "properties": {
                  "crossAxisAlignment": "stretch",
                  "mainAxisAlignment": "start"
                },
                "children": [
                  {
                    "id": "sidebar_container",
                    "type": "container",
                    "properties": {
                      "width": 250.0,
                      "backgroundColor": 4294309887,
                      "height": 700,
                      "heightMode": "max"
                    },
                    "children": [
