                                        "properties": {
                                          "flex": 1
                                        },
                                        "children": [
                                          {
                                            "id": "new_task_field",
                                            "type": "textField",
                                            "properties": {
                                              "inputVariableId": "new_task_title",
                                              "initialValue": "",
                                              "width": 108,
                                              "label": "",
                                              "hintText": "Add a task"
                                            },
                                            "children": []
                                          }
                                        ]
                                      },
                                      {
                                        "id": "spacer_64",
                                        "type": "spacer",
                                        "properties": {
                                          "flex": 1
                                        },
                                        "children": []
                                      },
                                      {
                                        "id": "new_task_add_button",
                                        "type": "iconButton",
                                        "properties": {
                                          "style": "filled",
                                          "actions": [
                                            {
                                              "id": "validate_new_task",
                                              "type": "conditional",
                                              "variableId": "new_task_title",
                                              "operator": "notEquals",
                                              "value": "",
                                              "thenActions": [
                                                {
                                                  "id": "insert_task_record",
                                                  "type": "databaseInsert",
                                                  "collectionId": "tasks",
                                                  "record": "{\"title\":\"$new_task_title\",\"status\":\"Open\"}"
                                                },
                                                {
                                                  "id": "clear_new_task_title",
                                                  "type": "setVariable",
                                                  "variableId": "new_task_title",
                                                  "value": ""
                                                }
                                              ],
                                              "elseActions": [
                                                {
                                                  "id": "empty_task_message",
                                                  "type": "snackbar",
                                                  "message": "Write a task before adding it."
                                                }
                                              ]
                                            }
                                          ],
                                          "iconName": "add",
                                          "tooltip": "Add task"
                                        },
                                        "children": []
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
